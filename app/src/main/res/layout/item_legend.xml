<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_s">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:contentDescription="@null"
            android:id="@+id/legendImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="2dp"
            android:src="@drawable/ic_user_placeholder"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/tertiary"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/rankBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_pill_search"
            android:backgroundTint="@color/tertiary"
            android:gravity="center"
            tools:text="1"
            android:textColor="@color/on_tertiary"
            android:textAppearance="@style/TextAppearance.CampusConnect.Caption"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/legendName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:ellipsize="end"
        android:maxWidth="80dp"
        android:maxLines="1"
        tools:text="User Name"
        android:textAppearance="@style/TextAppearance.CampusConnect.Caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/legendKarma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="500 pts"
        android:textColor="?attr/colorPrimary"
        android:textAppearance="@style/TextAppearance.CampusConnect.Caption" />

</LinearLayout>
