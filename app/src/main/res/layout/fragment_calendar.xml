<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The calendar card scrolls away as the event list scrolls up, and comes straight
         back (enterAlways) as soon as the list is scrolled down again. The
         "Upcoming Events" title has no scroll flag, so it stays pinned. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/calendarAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/calendarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_gutter"
            android:layout_marginVertical="@dimen/space_m"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="@dimen/radius_hero"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <com.applandeo.materialcalendarview.CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerColor="@color/event_card_navy"
                app:selectionColor="@color/event_card_navy"
                app:todayLabelColor="@color/qa_purple"
                app:pagesColor="@color/card_surface"
                app:abbreviationsBarColor="@color/card_surface"
                app:abbreviationsLabelsColor="@color/text_secondary"
                app:daysLabelsColor="@color/calendar_day"
                app:anotherMonthsDaysLabelsColor="@color/calendar_day_other_month" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/calendarFeedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_xs"
            android:text="@string/upcoming_events"
            android:textAppearance="@style/TextAppearance.CampusConnect.Section" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Shown in place of the list, right under the title, when nothing matches. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/calendarEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_s"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/radius_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_calendar"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/calendarEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:text="@string/calendar_no_events"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.CampusConnect.CardTitle" />

                <TextView
                    android:id="@+id/calendarEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/calendar_no_events_hint"
                    android:textAppearance="@style/TextAppearance.CampusConnect.BodySecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/calendarEventsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_xs" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
