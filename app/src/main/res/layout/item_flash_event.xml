<?xml version="1.0" encoding="utf-8"?>
<!-- "Live Now" carousel card. FlashEventAdapter widens it to match_parent when it is the only item. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/event_card_navy"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/flashImage"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/bg_image_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/liveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_s"
            android:background="@drawable/bg_live_badge"
            android:drawablePadding="@dimen/space_xs"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingVertical="3dp"
            android:text="@string/live_badge"
            android:textColor="@color/event_card_text"
            android:textSize="12sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/bg_live_dot"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/flashTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_m"
            android:layout_marginTop="@dimen/space_m"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.CampusConnect.CardTitle"
            android:textColor="@color/event_card_text"
            tools:text="Python Help"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/flashImage" />

        <TextView
            android:id="@+id/flashExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_m"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_m"
            android:textColor="@color/event_card_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Ends in 45m"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/flashTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
