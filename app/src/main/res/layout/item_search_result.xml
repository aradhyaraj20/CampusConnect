<?xml version="1.0" encoding="utf-8"?>
<!-- Search result card: same visual language as item_event, plus the "why it matched" line. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_gutter"
    android:layout_marginVertical="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/touch_target"
    app:cardBackgroundColor="@color/event_card_navy"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/eventImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/event_card_image_height"
            android:background="@drawable/bg_image_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/eventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_l"
            android:layout_marginTop="@dimen/space_m"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.CampusConnect.CardTitle"
            android:textColor="@color/event_card_text"
            tools:text="Event Title" />

        <TextView
            android:id="@+id/eventDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_l"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/event_card_text_secondary"
            android:textSize="13sp"
            tools:text="Date · Location" />

        <TextView
            android:id="@+id/matchReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_l"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center_vertical"
            android:textColor="@color/event_card_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="✨ Recommended because..."
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_m" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
