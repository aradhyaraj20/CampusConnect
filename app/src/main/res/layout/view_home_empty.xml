<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeEmptyState"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_xl"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingBottom="@dimen/space_xl"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/no_upcoming_events"
        android:textAppearance="@style/TextAppearance.CampusConnect.CardTitle"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:text="@string/no_upcoming_events_hint"
        android:textAppearance="@style/TextAppearance.CampusConnect.BodySecondary" />
</LinearLayout>
