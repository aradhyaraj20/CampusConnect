<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/offlineBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_m"
    android:visibility="gone"
    app:cardBackgroundColor="@color/warning_container"
    app:cardCornerRadius="@dimen/radius_card">

    <TextView
        android:id="@+id/offlineBannerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:padding="@dimen/space_m"
        android:text="@string/offline_saved"
        android:textColor="@color/on_warning_container" />
</com.google.android.material.card.MaterialCardView>
