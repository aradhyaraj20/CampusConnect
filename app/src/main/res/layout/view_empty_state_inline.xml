<?xml version="1.0" encoding="utf-8"?>
<!-- Compact empty state for a section inside a scrolling page (icon, title, subtitle). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_l"
    android:paddingBottom="@dimen/space_l">

    <ImageView
        android:id="@+id/emptyIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_info"
        app:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.CampusConnect.CardTitle"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/emptySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.CampusConnect.BodySecondary"
        android:textColor="@color/text_secondary" />
</LinearLayout>
