<?xml version="1.0" encoding="utf-8"?>
<!-- Horizontal carousel card ("Recommended for you"); same family as item_event. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/event_card_navy"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/recommendationImage"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/bg_image_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/recommendationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_m"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.CampusConnect.CardTitle"
            android:textColor="@color/event_card_text"
            tools:text="Recommended Event"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recommendationImage" />

        <TextView
            android:id="@+id/recommendationCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginBottom="@dimen/space_m"
            android:background="@drawable/bg_image_chip"
            android:backgroundTint="@color/event_card_accent"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingVertical="3dp"
            android:textColor="@color/event_card_navy"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Category"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recommendationTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
