<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CampusConnect" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="android:statusBarColor">@color/primary</item>

        <!-- Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.CampusConnect.Card</item>
        <item name="materialButtonStyle">@style/Widget.CampusConnect.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CampusConnect.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.CampusConnect.Dialog</item>
        <item name="snackbarStyle">@style/Widget.CampusConnect.Snackbar</item>
        <item name="android:windowAnimationStyle">@style/Animation.CampusConnect.Activity</item>
        <item name="toolbarStyle">@style/Widget.CampusConnect.Toolbar</item>
    </style>

    <!-- Cards: flat surface with a hairline border, so they stand out on the tinted page. -->
    <style name="Widget.CampusConnect.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
    </style>

    <!-- Buttons: one pill style everywhere; primary actions use the 52dp tall variant. -->
    <style name="Widget.CampusConnect.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.CampusConnect.Label</item>
    </style>

    <style name="Widget.CampusConnect.Button.Primary">
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <style name="ThemeOverlay.CampusConnect.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.CampusConnect.Dialog</item>
    </style>

    <style name="ShapeAppearance.CampusConnect.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_hero</item>
    </style>

    <style name="Widget.CampusConnect.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="android:layout_margin">@dimen/space_m</item>
    </style>

    <!-- Type scale: every screen picks from these instead of ad-hoc sizes. -->
    <style name="TextAppearance.CampusConnect.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CampusConnect.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CampusConnect.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CampusConnect.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CampusConnect.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CampusConnect.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.CampusConnect.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CampusConnect.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Screen transitions: new screens slide in from the right, Back slides them out. -->
    <style name="Animation.CampusConnect.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_exit_behind</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_enter_behind</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_exit</item>
    </style>

    <!-- One look for every bottom navigation bar (student, organizer, admin). -->
    <!-- Light raised bar, compact height, every tab labelled, tinted pill behind the selected icon. -->
    <style name="Widget.CampusConnect.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="android:minHeight">@dimen/bottom_nav_height</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">6dp</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">12dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.CampusConnect.BottomNav</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.CampusConnect.BottomNav.Active</item>
        <item name="itemRippleColor">@color/nav_indicator</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CampusConnect.BottomNav.Indicator</item>
    </style>

    <style name="Widget.CampusConnect.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
        <item name="android:width">56dp</item>
        <item name="android:height">28dp</item>
    </style>

    <style name="TextAppearance.CampusConnect.BottomNav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.CampusConnect.BottomNav.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Back arrow, menu icons and the 3-dot overflow are drawn in colorOnPrimary (white
         on the gradient bar) on every screen. -->
    <style name="Widget.CampusConnect.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="navigationIconTint">@color/on_header</item>
        <item name="titleTextColor">@color/on_header</item>
        <item name="subtitleTextColor">@color/on_header_secondary</item>
        <item name="android:theme">@style/ThemeOverlay.CampusConnect.Toolbar</item>
    </style>

    <style name="ThemeOverlay.CampusConnect.Toolbar" parent="">
        <!-- The toolbar always sits on the purple gradient, so its text/icons are white in
             light and dark mode alike (dark mode's colorOnPrimary is a dark purple). -->
        <item name="colorOnPrimary">@color/on_header</item>
        <item name="colorControlNormal">@color/on_header</item>
    </style>

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.CampusConnect" parent="Base.Theme.CampusConnect" />

    <!-- Settings list building blocks: one definition, consistent rows everywhere,
         all with >=48dp touch targets per accessibility requirements. -->
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="SettingsRowSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="SettingsSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">?attr/colorSurfaceVariant</item>
    </style>
</resources>
