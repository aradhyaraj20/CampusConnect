<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral image placeholder / error state: tinted surface with a centred picture glyph (not cropped by centerCrop). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/image_placeholder" />
        </shape>
    </item>
    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="center"
        android:drawable="@drawable/ic_image_placeholder" />
</layer-list>
